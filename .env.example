# Server-only configuration for the GameDex BFF.
# Copy to .env.local and fill in. Never prefix these with NEXT_PUBLIC_.

# RAWG API key — get one free at https://rawg.io/apidocs
GAME_API_KEY=

# Optional. Defaults to https://api.rawg.io/api
GAME_API_BASE_URL=

# Optional. Public origin used for canonical/Open Graph URLs (no trailing slash).
SITE_URL=

# Optional. Verification token from Google Search Console ("HTML tag" method),
# i.e. the content="…" value only.
GOOGLE_SITE_VERIFICATION=
